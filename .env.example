# Postgres connection string (Neon / Supabase / Vercel Postgres)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Random 32+ char string used to sign login cookies
AUTH_SECRET=change-me-to-a-long-random-string
# 64 hex chars (32 bytes) used to encrypt generated papers:  openssl rand -hex 32
PAPER_ENC_KEY=
# One-time token that protects /api/setup
SETUP_TOKEN=pick-a-secret-token
# First admin account created by /api/setup
ADMIN_NAME=Exam Cell Admin
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=change-this-password
# Number of OTHER admins who must approve before a paper can be downloaded (0 = none)
REQUIRED_APPROVALS=0
# Printed at the top of generated papers
INSTITUTE_NAME=Your University Name
